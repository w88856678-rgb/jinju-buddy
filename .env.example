# 从本目录启动。活动数据和操作口令只存在服务端。
HOST=127.0.0.1
PORT=4195
BUDDY_EVENT_ID=public-demo
BUDDY_EVENT_NAME=金句 Buddy · 公网体验
BUDDY_LOCAL_CONTROL=0
# BUDDY_DATA_DIR=/absolute/private/directory
# BUDDY_FONT_DIR=/absolute/font/directory
# HTTPS 反向代理需要支持 WebSocket。直接启动 TLS 可同时指定以下两项。
# TLS_CERT_FILE=
# TLS_KEY_FILE=
TENCENTCLOUD_APP_ID=
TENCENTCLOUD_SECRET_ID=
TENCENTCLOUD_SECRET_KEY=
# 仅填写已授权接收此密钥的 Hy4 Flash 兼容网关完整 URL。
BUDDY_HY4_ENDPOINT=
TOKENLINK_API_KEY=
